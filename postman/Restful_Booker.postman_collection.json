              "pm.test(\"First name is updated\", () => pm.expect(pm.response.json().firstname).to.eql(\"Aadesh Kumar\"));",
              "pm.test(\"Other fields are not changed\", () => pm.expect(pm.response.json().totalprice).to.eql(2000));"
            ]
          }
        }
      ]
    },
